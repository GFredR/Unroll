/* ============ M4: Voluntary crash report (§5.10) ============ */

/* Wording stays soft: never claim "it crashed" — it may just have been force-quit */
"crash.prompt.title" = "The app seems to have exited unexpectedly";
"crash.prompt.body" = "The previous session didn't shut down normally. Would you like to turn what was happening into a report for me?\n\nIt contains only the version, system, archive format, page count and the actions taken — no file names, paths or content. You can read it before submitting.";
"crash.prompt.report" = "Review Report…";
"crash.prompt.dismiss" = "Don't Ask Again";

/* ============ v2: reading actions completed (2026-09-16) ============ */

/* Window title: file name · page */
"reader.window.title" = "%@ · P.%ld/%ld";

/* File menu: save current page (⌘S) / show in Finder (⇧⌘F) / enter archive password (⇧⌘K) */
