/* 结论:有坏页 */
"integrity.damaged.title" = "发现 %ld 页读不出来";
"integrity.damaged.body" = "读不出来的页：%@";
"integrity.damaged.summary" = "其余 %ld 页可以正常阅读。这些页需要重新获取这个压缩包。";
"integrity.damaged.truncated" = "（只列出前 %ld 个）";
"integrity.pageSeparator" = "、";
"integrity.pageItem" = "第 %@ 页";

/* 结论:没跑完(被取消 / 反复失败) */
"integrity.stopped.title" = "检查没有跑完";
"integrity.stopped.body" = "只查到第 %ld / %ld 页就停了 —— 后面的页没有结论。";

/* 加密页跳过提示(不是损坏) */
"integrity.skipped" = "另有 %ld 页因为加密被跳过。输入解压密码后再检查，可以把它们一并算进来。";

