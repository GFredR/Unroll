/* App 名称(窗口标题 / 菜单栏) */
"app.name" = "开卷";

/* ============ M2:阅读器 ============ */

/* 空态(欢迎页) */
"reader.empty.title" = "开卷";
"reader.empty.hint" = "拖入 .cbz / .cbr / .cb7 / .cbt 漫画包,\n裸的 .zip / .rar / .7z / .tar 也认 —— 或在访达中双击打开。";
"reader.empty.open" = "打开文件…";

/* 打开中 */
"reader.opening" = "正在打开…";

/* 页码指示(画布右下角;M3 的 HUD 会替代) */
"reader.page.progress" = "%ld / %ld";

/* ---- 归档级错误(§5.9.3.1 八组,M3 做最终润色) ---- */

/* #1 ZIP 全部加密 —— v2 起会弹密码输入框,这条只剩防御分支兜底(见 openFailure) */
"archive.encrypted.title" = "此归档已加密";
"archive.encrypted.zip.body" = "这个压缩包里的文件需要密码才能读取。";

/* #2 7z 内容加密(实测:系统库不支持,给对密码也一样 —— 必须如实说) */
"archive.encrypted.7z.title" = "无法读取加密的 7z 内容";
"archive.encrypted.7z.body" = "系统自带的解压库不支持解密 7z 内容,即使有正确密码也读不出来。\n请改用未加密的压缩包,或先用其他工具解压。";

/* #3 RAR 内容加密(⚠️ 仍无样本、未实测;措辞必须**弱于** 7z —— 见设计文档 §5.8) */
"archive.encrypted.rar.title" = "无法读取加密的 RAR 内容";
"archive.encrypted.rar.body" = "系统自带的解压库可能不支持这个 RAR 的加密方式。\n可以试试其他压缩包,或先用其他工具解压。";

/* #4 头部加密 */
"archive.encrypted.header.title" = "无法读取这个归档";
"archive.encrypted.header.body" = "这个压缩包的文件名列表本身也被加密了,程序无法得知里面有哪些内容。";

/* #5 部分加密 · 页级占位卡片 */
"archive.page.encrypted.title" = "此页已加密";
"archive.page.encrypted.subtitle" = "其余 %ld 页可正常阅读;输入解压密码可一并解开";

/* #6 解压密码输入(v2,2026-09-17) */
"archive.password.title" = "这个文件需要密码";
"archive.password.body" = "输入解压密码后即可查看内容。";
"archive.password.unlock.title" = "解锁加密页";
"archive.password.unlock.body" = "输入密码后,原本读不出的页面会一起解开。";
"archive.password.placeholder" = "解压密码";
"archive.password.submit" = "解锁";
"archive.password.cancel" = "取消";
"archive.password.reveal" = "显示密码";
"archive.password.hide" = "隐藏密码";
"archive.password.wrong.title" = "密码不对";
"archive.password.wrong.body" = "再试一次。密码区分大小写,留意输入法与首尾空格。";
"archive.password.unsupported.title" = "这个归档解不开";
"archive.password.unsupported.body" = "系统自带的解压库不支持这个归档的加密方式,换密码也读不出来。";

/* #6 损坏 / 非归档 */
"archive.corrupted.title" = "无法打开这个文件";
"archive.corrupted.body" = "文件可能已损坏,或不是支持的格式(cbz / cbr / cb7 / cbt / zip)。";

/* #7 无图片 */
"archive.noImages.title" = "归档内没有找到图片";
"archive.noImages.body" = "已读取 %ld 个条目,但没有一个是图片格式。";

/* #8 错误态通用按钮 */
"archive.error.chooseAnother" = "打开其他文件…";

/* ---- M2 补充(§5.9.3.1 未定义的最小组,M3 一并润色) ---- */
"archive.empty.title" = "归档里没有内容";
"archive.empty.body" = "这个压缩包里没有包含任何文件。";
"archive.page.failed.title" = "这一页读取失败";
"archive.page.failed.body" = "这一页不是图片,或已损坏(两种情况都读不出来)。其余页面不受影响。";

