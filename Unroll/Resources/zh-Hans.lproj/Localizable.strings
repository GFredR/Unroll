/* ============ M4:崩溃自愿上报(§5.10) ============ */

/* 文案要软:不断言「崩溃了」—— 也可能是被强杀(§5.10.3-②) */
"crash.prompt.title" = "上次似乎异常退出";
"crash.prompt.body" = "上次运行时没能正常关闭。可以把当时的操作记录整理成一份报告发给我吗?\n\n报告里只有版本、系统、归档格式、页数和操作步骤 —— 不含文件名、路径或任何内容,提交前你可以先看一遍。";
"crash.prompt.report" = "查看报告…";
"crash.prompt.dismiss" = "不再询问";

/* ============ v2:阅读操作补完(2026-09-16) ============ */

/* 窗口标题:文件名 · 页码(多窗口 / Dock 悬停辨认用) */
"reader.window.title" = "%@ · P.%ld/%ld";

/* 文件菜单:另存当前页(⌘S)/ 在访达中显示(⇧⌘F)/ 输入解压密码(⇧⌘K) */
"app.menu.saveCurrentPage" = "另存当前页…";
"app.menu.revealInFinder" = "在访达中显示";
"app.menu.unlock" = "输入解压密码…";

/* 写盘失败(刻意不带系统错误原文 —— 那串文字可能含完整路径) */
"app.alert.saveFailed.title" = "保存失败";
"app.alert.saveFailed.body" = "没能写入所选位置，换一个位置再试一次。";

/* HUD 进度条的悬停提示(现在可以拖着跳页了) */
"reader.hud.progress.hint" = "拖动跳页";

/* ============ v2:「检查归档完整性」(2026-09-17) ============ */

/* 文件菜单(⌥⌘V 取 Verify 的联想键) */
"app.menu.checkIntegrity" = "检查归档完整性…";

/* 结果面板 */
"integrity.title" = "检查归档完整性";
"integrity.hint" = "逐页读取全部内容(不解码图片)。大归档可能要跑一会儿，随时可以停止。";
"integrity.running" = "正在检查… %ld / %ld";
"integrity.stop" = "停止";
"integrity.done" = "完成";

/* 结论:干净 */
"integrity.ok.title" = "没有发现损坏";
