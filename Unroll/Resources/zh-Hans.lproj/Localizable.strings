/* App 名称(窗口标题 / 菜单栏) */
"app.name" = "开卷";

/* ============ M2:阅读器 ============ */

/* 空态(欢迎页) */
"reader.empty.title" = "开卷";
"reader.empty.hint" = "拖入 .cbz / .cbr / .cb7 / .cbt 漫画包,\n裸的 .zip / .rar / .7z / .tar 也认 —— 或在访达中双击打开。";
"reader.empty.open" = "打开文件…";

/* 打开中 */
"reader.opening" = "正在打开…";

/* 页码指示(画布右下角;M3 的 HUD 会替代) */
"reader.page.progress" = "%ld / %ld";

/* ---- 归档级错误(§5.9.3.1 八组,M3 做最终润色) ---- */

/* #1 ZIP 全部加密 */
"archive.encrypted.title" = "此归档已加密";
"archive.encrypted.zip.body" = "这个压缩包里的文件都需要密码才能读取。\n当前版本暂不支持输入密码。";

/* #2 7z 内容加密(实测:系统库不支持,如实说) */
"archive.encrypted.7z.title" = "无法读取加密的 7z 内容";
"archive.encrypted.7z.body" = "系统自带的解压库不支持解密 7z 内容,即使有正确密码也读不出来。\n请改用未加密的压缩包,或先用其他工具解压。";

/* #3 RAR 内容加密(⚠️ 未实测,暂按「系统库不支持」撰写,§5.8) */
"archive.encrypted.rar.title" = "无法读取加密的 RAR 内容";
"archive.encrypted.rar.body" = "系统自带的解压库不支持解密 RAR 内容。\n请改用未加密的压缩包,或先用其他工具解压。";

/* #4 头部加密 */
"archive.encrypted.header.title" = "无法读取这个归档";
"archive.encrypted.header.body" = "这个压缩包的文件名列表本身也被加密了,程序无法得知里面有哪些内容。";

/* #5 部分加密 · 页级占位卡片 */
"archive.page.encrypted.title" = "此页已加密";
"archive.page.encrypted.subtitle" = "其余 %ld 页可正常阅读";

/* #6 损坏 / 非归档 */
"archive.corrupted.title" = "无法打开这个文件";
"archive.corrupted.body" = "文件可能已损坏,或不是支持的格式(cbz / cbr / cb7 / cbt / zip)。";

/* #7 无图片 */
"archive.noImages.title" = "归档内没有找到图片";
"archive.noImages.body" = "已读取 %ld 个条目,但没有一个是图片格式。";

/* #8 错误态通用按钮 */
"archive.error.chooseAnother" = "打开其他文件…";

/* ---- M2 补充(§5.9.3.1 未定义的最小组,M3 一并润色) ---- */
"archive.empty.title" = "归档里没有内容";
"archive.empty.body" = "这个压缩包里没有包含任何文件。";
"archive.page.failed.title" = "这一页读取失败";
"archive.page.failed.body" = "文件可能部分损坏,其余页面不受影响。";

/* ============ M3:菜单命令 / 阅读模式 ============ */

/* 文件菜单 */
"app.menu.open" = "打开…";
"app.menu.openRecent" = "打开最近";
"app.menu.clearRecent" = "清除菜单";

/* 视图菜单 */
"app.menu.view" = "视图";
"reader.layout.single" = "单页";
"reader.layout.dual" = "双页";
"reader.direction.ltr" = "从左往右读";
"reader.direction.rtl" = "从右往左读(日漫)";
"app.menu.firstPage" = "回到封面";
"app.menu.lastPage" = "跳到末页";

/* 缩放档位(⌘3-⌘6) */
"reader.fit.window" = "适应窗口";
"reader.fit.width" = "适应宽";
"reader.fit.height" = "适应高";
"reader.fit.actual" = "实际大小(1:1)";

/* ============ M4:崩溃自愿上报(§5.10) ============ */

/* 文案要软:不断言「崩溃了」—— 也可能是被强杀(§5.10.3-②) */
"crash.prompt.title" = "上次似乎异常退出";
"crash.prompt.body" = "上次运行时没能正常关闭。可以把当时的操作记录整理成一份报告发给我吗?\n\n报告里只有版本、系统、归档格式、页数和操作步骤 —— 不含文件名、路径或任何内容,提交前你可以先看一遍。";
"crash.prompt.report" = "查看报告…";
"crash.prompt.dismiss" = "不再询问";
